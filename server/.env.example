# Скопируйте в server/.env и заполните. Реальные ключи — только в .env, не в коде и не в git.

# Порт HTTP-сервера
PORT=8787

# Публичный адрес ЭТОГО сервера (https, без слэша в конце). Нужен для вебхуков Telegram-ботов:
# https://api.example.ru/api/tg/<botId>. Для локальной отладки ботов — https-туннель (ngrok, cloudflared).
PUBLIC_API_URL=

# Адрес игры (фронта). Сюда ЮKassa вернёт игрока после оплаты: <адрес>?payment=return&pid=<localId>
# Обязателен, если платежи не демо.
PUBLIC_GAME_URL=

# С каких адресов фронт может ходить на API (CORS), через запятую, например:
# https://game.example.ru,https://user.github.io
# Пусто — только локальный Vite (http://localhost:5173 и :4173).
ALLOWED_ORIGINS=

# IP клиента для лимитов берётся из X-Real-IP / X-Forwarded-For, если запрос пришёл с loopback
# (nginx на этой же машине: proxy_set_header X-Real-IP $remote_addr;).
# true — доверять этим заголовкам от любого адреса (прокси в Docker или на другой машине).
# Включайте, только если прямой доступ к порту закрыт, иначе заголовок можно подделать.
TRUST_PROXY=false

# true — демо-платежи: покупка выдаётся сразу, без денег. Демо включается и само, если нет ключей ЮKassa.
DEMO_PAYMENTS=false

# ЮKassa: личный кабинет → Интеграция → Ключи API.
# В кабинете включите HTTP-уведомления на <PUBLIC_API_URL>/api/webhooks/yookassa
# (события payment.succeeded и payment.canceled).
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# true — передавать чек по 54-ФЗ (email покупателя, НДС «без НДС», услуга, полная оплата)
YOOKASSA_RECEIPTS=false

# Ключ Claude API для Совы-наставника. Пусто — наставник выключен (503 ai_disabled).
ANTHROPIC_API_KEY=
# Модель наставника (по умолчанию claude-sonnet-5-5)
MENTOR_MODEL=claude-sonnet-5-5

# Ключ шифрования токенов ботов и данных лидов (AES-256-GCM): 32 байта в hex (64 символа) или base64.
# Сгенерировать: openssl rand -hex 32
# Не меняйте после запуска — сохранённые токены и данные лидов перестанут расшифровываться.
# Пусто (или пустой PUBLIC_API_URL) — боты выключены (503 bots_disabled).
BOT_TOKEN_KEY=

# Папка для базы SQLite (psyquest.db). Относительный путь — от папки server/. По умолчанию ./data
DATA_DIR=./data
